# =============================================================================
#  config/paths.env — ou se trouvent les dependances (configuration d'INSTALLATION)
# =============================================================================
#
#  Ce fichier repond a une seule question : OU sont les choses sur CETTE machine.
#  Il ne decrit aucun comportement d'emulation — cela releve de calypso.env.
#
#  Tous les chemins ci-dessous sont surchargeables depuis l'environnement grace a
#  l'idiome `:=`. Autrement dit :
#
#      GSM_ROOT=/home/moi/gsm ./run.sh          # surcharge ponctuelle
#      export OSMOCOM_BB=~/src/osmocom-bb       # surcharge persistante
#
#  ATTENTION a l'idiome : `:=` laisse la ligne de commande gagner, `=` la verrouille.
#  N'utilisez `=` que si une valeur ne DOIT jamais etre surchargee.
#
#  Verifier son installation :   ./run.sh --check-paths
# -----------------------------------------------------------------------------

# --- Racine de l'installation -------------------------------------------------
# Tout le reste en derive par defaut. Changer cette seule ligne suffit si vous
# avez respecte la disposition d'origine.
: "${GSM_ROOT:=/opt/GSM}"

# --- Ce depot -----------------------------------------------------------------
# Detecte automatiquement depuis l'emplacement du script ; ne pas coder en dur.
: "${QEMU_TREE:=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
# Binaire QEMU. On prend le build local s il existe ; sinon on retombe sur un
# build voisin, ce qui permet d essayer la chaine avant d avoir compile.
# Pour compiler ici :  ./configure --target-list=arm-softmmu && ninja -C build qemu-system-arm
if [ -x "$QEMU_TREE/build/qemu-system-arm" ]; then
    : "${QEMU_BIN:=$QEMU_TREE/build/qemu-system-arm}"
elif [ -x "$GSM_ROOT/osmo-qemu-calypso/build/qemu-system-arm" ]; then
    : "${QEMU_BIN:=$GSM_ROOT/osmo-qemu-calypso/build/qemu-system-arm}"
else
    : "${QEMU_BIN:=$QEMU_TREE/build/qemu-system-arm}"
fi
: "${QEMU_TOOLS:=$QEMU_TREE/tools}"
: "${QEMU_SCRIPTS:=$QEMU_TREE/scripts}"
: "${QEMU_CFGS:=$QEMU_TREE/cfgs}"

# --- Firmware ARM (osmocom-bb, cible compal_e88) ------------------------------
# [2026-08-28] SOURCE UNIQUE : $GSM_ROOT/firmware. La cascade est supprimee.
#
# Il y avait ici trois branches essayees dans l'ordre : un arbre de build
# EMBARQUE dans ce depot, une ancienne copie a plat, puis $GSM_ROOT/firmware en
# repli. Avec elles disparait la question « laquelle a gagne cette fois-ci ? »,
# a laquelle on ne repondait qu'apres coup, en lisant la ligne de commande du
# process.
#
# Ce que la cascade coutait, mesure sur banc (ISO live, 2026-08-28) : l'arbre
# embarque n'y existe meme pas, le run partait donc du repli -- pendant que
# build-iso.sh posait un lien pour reparer une premiere branche que plus
# personne n'empruntait. Deux mecanismes pour un seul chemin.
#
# CONTREPARTIE : recompiler osmocom-bb ne change plus ce que le run charge. Il
# faut deposer le resultat dans $GSM_ROOT/firmware, explicitement. C'est le prix
# d'un chemin unique, et il se paie une fois, visiblement.
#
# Surcharge ponctuelle, toujours possible (la ligne de commande gagne) :
#     FIRMWARE_DIR=/opt/GSM/osmocom-bb/src/target/firmware ./run.sh
# Le juge reste le process, jamais la ligne de commande :
#     ps -C qemu-system-arm -o args= | grep -o "[-]kernel [^ ]*"
: "${FIRMWARE_DIR:=$GSM_ROOT/firmware}"
: "${FIRMWARE_ELF:=$FIRMWARE_DIR/board/compal_e88/layer1.highram.elf}"
: "${FIRMWARE_BIN:=$FIRMWARE_DIR/board/compal_e88/layer1.highram.bin}"
: "${FIRMWARE_MAP:=$FIRMWARE_DIR/board/compal_e88/layer1.highram.map}"

# --- ROM du DSP TMS320C54x ----------------------------------------------------
# Six binaires extraits du silicium. Sans eux, le DSP emule ne demarre pas.
: "${DSP_ROM_DIR:=$GSM_ROOT}"
: "${DSP_PROM0:=$DSP_ROM_DIR/calypso_dsp.PROM0.bin}"
: "${DSP_PROM1:=$DSP_ROM_DIR/calypso_dsp.PROM1.bin}"
: "${DSP_PROM2:=$DSP_ROM_DIR/calypso_dsp.PROM2.bin}"
: "${DSP_PROM3:=$DSP_ROM_DIR/calypso_dsp.PROM3.bin}"
: "${DSP_DROM:=$DSP_ROM_DIR/calypso_dsp.DROM.bin}"
: "${DSP_PDROM:=$DSP_ROM_DIR/calypso_dsp.PDROM.bin}"
: "${DSP_REGISTERS:=$DSP_ROM_DIR/calypso_dsp.Registers.bin}"

# --- Sources osmocom-bb (osmocon, mobile, outils) -----------------------------
: "${OSMOCOM_BB:=$GSM_ROOT/osmocom-bb}"
: "${OSMOCON:=$OSMOCOM_BB/src/host/osmocon/osmocon}"
: "${MOBILE_BIN:=$OSMOCOM_BB/src/host/layer23/src/mobile/mobile}"
: "${IRDA_PEER:=$OSMOCOM_BB/src/target/firmware/tools/irda_peer.py}"

# --- osmo-trx (transceiver IPC) -----------------------------------------------
: "${OSMO_TRX:=$GSM_ROOT/osmo-trx}"
: "${OSMO_TRX_IPC_DIR:=$OSMO_TRX/Transceiver52M/device/ipc}"

# --- Configuration Osmocom (BTS, BSC, MSC, TRX) -------------------------------
: "${OSMOCOM_CFG:=/etc/osmocom}"
: "${OSMOCOM_HOME:=$HOME/.osmocom}"

# --- Environnement Python (gr-gsm, outils d'analyse) --------------------------
# Laisser vide pour utiliser le python du systeme.
: "${PYTHON_VENV:=$GSM_ROOT/calypso-venv}"
: "${PYTHON_BIN:=${PYTHON_VENV:+$PYTHON_VENV/bin/}python3}"

# --- Sorties : logs, captures, fichiers temporaires ---------------------------
# Un tiers n'a aucune raison d'ecrire dans /root.
: "${RUN_DIR:=${XDG_RUNTIME_DIR:-/tmp}/calypso}"
# [2026-08-03] LES JOURNAUX RESTENT SUR LE TMPFS. Arbitrage entre DEUX pannes
# reelles, vecues le meme jour :
#   A — /tmp sature (30/07 x2, 03/08) : compilation qui echoue, journaux perdus.
#       CORRIGE A LA SOURCE : start.sh cree le conteneur avec --tmpfs /tmp:size=2g.
#   B — defilement tmux saccade, provoque par le contournement de A (LOG_DIR sous
#       /root). Bissecte sur le commit 1d241a0 puis confirme par retour arriere.
#       Mecanisme : / est un overlay a 16 couches ou inotify ne remonte pas ;
#       `tail -F` retombe sur du sondage a 1 s et le flux arrive en paquets.
# Les journaux vivent donc sur le tmpfs, seul systeme de fichiers ici ou inotify
# fonctionne. Si le volume redevient un probleme : tarir la SOURCE
# (CALYPSO_INTM_TRANS=0 = 56 %% du flux, CALYPSO_MAILBOX=0), pas deplacer la cible.

: "${LOG_DIR:=/tmp/calypso/logs}"
: "${CAPTURE_DIR:=$RUN_DIR/captures}"
: "${SHM_DIR:=/dev/shm}"

# --- Le depot voisin : le reseau Osmocom --------------------------------------
# Les deux depots sont concus pour vivre COTE A COTE. On cherche donc d abord a
# cote, puis a l emplacement conventionnel. NITB_ROOT force le chemin.
if [ -x "$QEMU_TREE/../osmo_egprs/run.sh" ]; then
    : "${NITB_ROOT:=$(cd "$QEMU_TREE/../osmo_egprs" && pwd)}"
else
    : "${NITB_ROOT:=$GSM_ROOT/osmo_egprs}"
fi
