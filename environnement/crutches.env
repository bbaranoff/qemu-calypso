# =============================================================================
#  config/crutches.env — LES BÉQUILLES
# =============================================================================
#  ⚠️ Tout ce qui est ici CONTOURNE une branche non implémentée. Ce ne sont pas
#  des options : ce sont des dettes. Toutes désactivées par défaut.
#
#  Les recenser dans le code :
#      grep -rn "@BEQUILLE" hw/arm/calypso/*.c hw/arm/calypso/*.h calypso*.env
#      grep -rhoE "@BEQUILLE — [A-Za-z_0-9]+" hw/arm/calypso/*.c | sort -u
#  105 béquilles sont annotées à leur site de lecture, avec ce qu'elles masquent
#  et la condition qui les rendrait inutiles.
#
#  RÈGLE : toute mesure obtenue avec l'une d'elles doit être citée comme
#  « mesure sous béquille ». C'est ainsi qu'on a cru analyser pendant des heures
#  un étage de démodulation qui, en natif, n'est jamais exécuté.
# -----------------------------------------------------------------------------

# --- Reroute du corrélateur --------------------------------------------------
# Masque   : l'absence de dispatch natif vers le corrélateur.
# Retirer  : quand le chemin natif l'atteint seul.
# : "${CALYPSO_FB_ENERGY:=1}" ; : "${CALYPSO_FB_CORR_ENTRY:=0x9500}"

# --- Injection d'échantillons ------------------------------------------------
# Masque   : l'absence de DMA on-chip — injecte un échantillon à chaque lecture.
# Retirer  : quand le tampon est alimenté par le vrai chemin.
# : "${CALYPSO_FB_STREAM:=1}"

# --- Détection FB côté hôte --------------------------------------------------
# Masque   : le corrélateur DSP lui-même. Court-circuite son résultat.
# ⚠️ MASQUE LE NATIF : ne jamais l'activer pour juger de l'état du mode natif.
#    Seule data[0x08f8], via la ligne DETECTOR-RUN, mesure le DSP.
# : "${CALYPSO_SHUNT_REAL_FB:=1}"

# --- Ouverture du feed BSP ---------------------------------------------------
# ⚠️ Idiome EXISTS : « =0 » NE LA COUPE PAS, il faut `unset`.
#    N'a d'effet que si CALYPSO_DSP_RUN_C54X vaut exactement "1".
# : "${CALYPSO_BSP_DARAM_FORCE:=1}"

# --- Profil « natif aidé » ---------------------------------------------------
# ⚠️ N'est PAS le mode natif : repose FB_CORR_ENTRY=0x9500, FB_ENERGY=1,
#    FB_IQ_DARAM=1, FB_IQ_BASE=0x9210. Un run qui le garde ne teste jamais le
#    chemin natif — il compare deux béquilles.
# : "${CALYPSO_NATIVE_HELPED:=1}"

# --- Injection d'un vecteur d'interruption DSP -------------------------------
# Masque   : la SOURCE MATÉRIELLE d'une IT DSP que le modèle n'implémente pas.
#            Mesuré le 30/07 : la tâche FB arme `data[0x0158..0159] = call 0x728a`
#            (13×), ce tremplin n'est atteignable que par le slot d'IT 30
#            (`data[0x00F8..0x00FB]` = « fb 0x0158 », recopié de PDROM 0xe399), son
#            IMR bit 14 est démasqué en permanence, et l'IFR ne prend jamais que
#            0x0020/0x0008 → rien ne lève jamais ce bit.
# N'injecte que quand le handler FB est réellement en place (`data[0x0159]==0x728a`),
# donc jamais pendant la fenêtre où la boucle principale a remis son handler léger.
# Cadence _PERIOD insn (défaut 65536 = une par trame), plafond dur 200 injections.
# ⚠️ CE N'EST PAS UN CORRECTIF : c'est un test décisif, il dit si tout l'aval du
#    vecteur est sain. Avec SEED5AC8 et DISPATCH_INSTALL ça fait TROIS béquilles
#    simultanées — on ne mesure alors plus le natif du tout.
# Retrait  : dès qu'on sait quelle ligne matérielle porte ce vecteur. C'est une
#            lacune DOCUMENTAIRE (la table des IT du DSP Calypso n'est nulle part
#            dans le dépôt), pas un bug à chercher au grep.
# : "${CALYPSO_FORCE_VEC:=30}" ; : "${CALYPSO_FORCE_VEC_PERIOD:=65536}"
