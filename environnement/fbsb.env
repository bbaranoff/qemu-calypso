# --- Pendant SB du feed FB (ajoute 2026-08-22) ------------------------
# @BEQUILLE de DIAGNOSTIC. FB_IQ_DARAM ne nourrit que le buffer FB (0x2a00) et
# seulement sur trames FCCH. Le correlateur SB lit un AUTRE buffer, 0x0e4e
# (destination du DMA SB, AAD=0xc9c), que PERSONNE n alimente -> le SB correle
# du vide : `TOA=0 Power=-138dBm`, `=> SB 0x00000000 BSIC=0`, a_sch toujours 0.
# Ce feed ecrit 296 mots decimes (I puis Q) en 0x0e4e sur les trames SCH
# ({2,12,22,32,42} mod 51). Il repond a UNE question : « le SB sait-il correler
# quand on le nourrit ? » — ce n est PAS un correctif. Tant qu il est actif le
# verdict natif est fausse, au meme titre que CALYPSO_GRGSM_FN_AUTOSYNC=1.
# Le vrai fix = faire alimenter 0x0e4e par BSP -> RHEA DMA sur les trames SCH.
#
#   defaut : code OFF
# : "${CALYPSO_SB_IQ_DARAM:=1}"

#   defaut : code 0x0e4e (destination du DMA SB)
# : "${CALYPSO_SB_IQ_BASE:=0x0e4e}"

#   defaut : code OFF ; native:=1
# : "${CALYPSO_FB_STREAM:=1}"

#   defaut : code 0x9213
# : "${CALYPSO_FB_STREAM_CELL:=1}"

#   defaut : code 0x9215
# : "${CALYPSO_FB_STREAM_CELLQ:=1}"

#   defaut : **code 4** (recensement dit 1 → FAUX)
# : "${CALYPSO_FB_STREAM_DECIM:=1}"

#   defaut : hack.env:=0 ; **run.sh:1155 =0 VERROUILLÉ en mode full-grgsm**
# : "${CALYPSO_FORCE_AGCH:=1}"

#   defaut : hack.env:=0 ; **run.sh:1154 =0 VERROUILLÉ**
# : "${CALYPSO_FORCE_FBSB:=1}"

#   defaut : code off
# : "${CALYPSO_FORCE_NB:=1}"

#   defaut : code -1 (off) ; jamais posé dans un .env (seulement documenté run...
# : "${CALYPSO_FORCE_TOA:=1}"

#   defaut : code OFF
# : "${CALYPSO_SHUNT_DSP_FB:=1}"

#   defaut : code 20000 insn
# : "${CALYPSO_SHUNT_DSP_FB_BUDGET:=1}"

#   defaut : code 0x94f5
# : "${CALYPSO_SHUNT_DSP_FB_ENTRY:=1}"

#   defaut : code 40 excursions
# : "${CALYPSO_SHUNT_DSP_FB_MAX:=1}"

#   defaut : code 0x5000
# : "${CALYPSO_SHUNT_DSP_FB_SP:=1}"

#   defaut : calypso.env:=0 ; hack:=0 ; native:=0 ; shunt_no_legit:=1
# : "${CALYPSO_SHUNT_REAL_FB:=1}"


