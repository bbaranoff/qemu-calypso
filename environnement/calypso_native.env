# calypso_native.env — mode NATIF PUR (le DSP fait le FBSB, zéro injection host)
# ---------------------------------------------------------------------------
# Le corrélateur DSP natif (mask-ROM) ingère l'IQ FCCH réel via FB-STREAM
# (data[0x9213]/[0x9215], cf [[native-fb-input-9213-writable]]) et doit produire
# d_fb_det lui-même. AUCUN résultat n'est injecté par le shunt. Go-live armé
# (recette shadow : BGEN + KEEP_IMR + INIT_435B, SANS CTRLSYS).
# Active : CALYPSO_NATIVE=1. Idiome := => CLI surcharge.
# ---------------------------------------------------------------------------
: "${CALYPSO_SHUNT_LEGIT:=0}"            # PAS de shunt legit
: "${CALYPSO_SHUNT_NO_LEGIT:=0}"         # PAS d'injections explicites
: "${CALYPSO_SHUNT_REAL_FB:=0}"          # PAS de FB host (le DSP le fait)
# --- DSP natif tourne + corrélateur alimenté ---
: "${CALYPSO_DSP_RUN_C54X:=1}"           # réveille le c54x natif
: "${CALYPSO_DSP_SHUNT:=0}"              # NE PAS shunter le DSP
: "${CALYPSO_FB_ENERGY:=1}"              # reroute CALA -> corrélateur énergie
: "${CALYPSO_FB_CORR_ENTRY:=0x9500}"     # entrée corrélateur
: "${CALYPSO_FB_STREAM:=1}"              # feed IQ FCCH frais -> data[0x9213/0x9215]
: "${CALYPSO_BSP_DIRECT_FEED:=1}"        # bursts -> DARAM
# --- go-live armé (recette shadow correcte, SANS CTRLSYS) ---
: "${CALYPSO_ARM2DSP_BGEN:=1}"           # ARM pose 098a/098c (go-live)
: "${CALYPSO_ARM2DSP_CTRLSYS:=0}"        # PAS de CTRLSYS (casse le go-live)
: "${CALYPSO_KEEP_IMR:=1}"               # maintient l'IMR armé
: "${CALYPSO_INIT_435B_OFF:=0}"          # seed shadow d[0x435b]=0x52ed
: "${CALYPSO_FRAME_IT_NATIVE:=1}"        # livraison frame-IT native
: "${CALYPSO_DECAN:=1}"                  # modèles RF (IQ réaliste)
