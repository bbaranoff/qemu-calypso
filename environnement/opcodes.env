# =============================================================================
#  config/opcodes.env — Opcodes / ISA / mask-ROM / bootstrap / dispatcher
# =============================================================================
#  50 variables. Reference complete (defaut, effet mesure, mode, idiome,
#  dependances) : ../hw/arm/calypso/doc/VARIABLES_ENVIRONNEMENT.md
#
#  RAPPEL : `=0` ne coupe pas tout. Quatre idiomes coexistent ; pour celles
#  qui testent la PRESENCE de la variable, seul `unset` les desactive.
# -----------------------------------------------------------------------------

# --- Parametres legitimes (2) ----------------------------------------
#  Reglables. Le materiel reel a un equivalent.

#   defaut : absent ⇒ -1 = global
: "${CALYPSO_FORCE_DP_FROM:=}"

# ⚠️ Historique, parce que ce commutateur a coûté cher.
#   Déclarée VIDE jusqu'au 2026-07-29 : sous l'ancien idiome « getenv(X)?1:0 »
#   une variable vide compte comme SET, donc la branche BUGUÉE tournait en
#   permanence, à l'inverse de ce que la ligne laissait croire. En migrant vers
#   calypso_gate j'ai reproduit le COMPORTEMENT observé (=1) plutôt que
#   l'INTENTION — et j'ai ainsi figé le bug.
#
# CE QUE FAIT LA BRANCHE 1 (buguée) : « LD #k8u » (0xE8/0xE9) place l'immédiat
#   en bits 16-23 au lieu des bits bas. Au tremplin terminal de la mask-ROM
#       0xb408 ld #0x39,A   0xb409 add #0x4387,A   0xb40b stlm A,AR7
#   ça donne AR7 = 0x4387 — la base nue, slot IDLE, data=0xab38=RET en banque 0
#   — au lieu de 0x4387+0x39 = 0x43C0, le slot GO-LIVE (data=0xa4c7).
#   Le BACC saute donc sur un RET : c'est LE STORM.
#   Même effet sur le dispatcher indexé 0xb0f0 (ld #0x25 + add #0x4387).
#
# MESURÉ le 2026-07-29 à 16:00 en basculant à 0, mode natif :
#   BACC-DISP handler=0xa4c7 <<REAL>>   (au lieu de 0xab38 (RET/noop))
#   TASKGO 0 -> 1009    FBCALL 0 -> 307    COEFFS-WR 0 -> 202 puis 512
#   avec CALYPSO_FRAME_IT_NATIVE=1 : INTM-TRANS 2 -> 1298, 0xb01e atteint
#
# ⚠️ EFFET ISA GLOBAL : « LD #k8u » est un opcode banal, ce commutateur change
#   sa sémantique dans TOUT le firmware DSP. Remettre 1 restaure le bug — c'est
#   la bascule A/B, gardée pour comparer. Non-régression `shunt_legit` (camp +
#   LU + SMS) restant à faire sous la valeur 0.
: "${CALYPSO_LDK8_SHIFT16:=0}"


# --- Correctifs ISA du 2026-08-22 (decodeur c54x) ---------------------
#  Les quatre corrigent des handlers PARASITES : un encodage etait occupe par
#  une instruction dont le VRAI handler existe deja ailleurs dans le fichier
#  (RPTB=0xF072, BITF=0x6100, CMPS=0x8E00, PSHD=0x4B00, SACCD=0x9E00...).
#  Reference : hw/arm/calypso/doc/RAPPORT_OPCODES.md sections A et B.
#
#  ⚠️ EFFET ISA GLOBAL sur les quatre : ces familles servent aussi aux filtres,
#  au Viterbi et aux tampons I/Q. NON-REGRESSION `shunt_legit` (camp + LU + SMS)
#  RESTANT A FAIRE, comme pour CALYPSO_LDK8_SHIFT16 ci-dessus.
#  Chacun a `=0` restaure INTEGRALEMENT l'ancien decodage (bisection un par un).

# 0xC000-0xDFFF = « ST src,Ymem || add/sub/ld/mpy/mac[r]/mas[r] Xmem,dst », 1 MOT.
#   Etait decoupe en RPTB[D]/PSHD/RPT/SACCD/DELAY/NOP, dont DEUX de 2 MOTS
#   (0xC2/C3/C6/C7 et 0xC4, 0xDA) -> un mot avale par site.
#   MESURE 22/08 : c'est le noyau du correlateur FB/SB (PDROM 0xf16c..0xf17e).
#   Avant : angle 1366..18322 Hz, d_fb_det 1 fois sur ~95.
#   Apres : angle -6/+2 Hz stable, pm ~5450 stable, l'etage SB est atteint.
: "${CALYPSO_ISA_PAR_ST:=1}"

# 0xE4xx/0xE6xx = « ST src,Ymem || LD Xmem,T », 1 MOT, masque 0xFD00.
#   Etait « BITF Smem,#lk » 2 MOTS -> desynchronisation du PC.
#   ⚠️ Masque 0xFD00 et NON 0xFC00 : 0xE5=MVDD et 0xE7=MVMM sont des
#   instructions differentes, reellement utilisees (79 MVDD dans PROM0).
#   ⚠️ NON INSTRUMENTE : on ignore s'il est exerce a l'execution.
: "${CALYPSO_ISA_E4_PAR:=1}"

# 0xE0=FIRS (2 MOTS) / 0xE1=LMS / 0xE2=SQDST / 0xE3=ABDST — etaient decodes en
#   CMPS 1 mot. Corrige la LARGEUR DE MOT ; E1-E3 rendus inertes plutot que faux.
#   ⚠️ MESURE 22/08 : 0 occurrence a l'execution en profil natif -> INERTE ici.
#   Correction de fidelite, sans effet mesurable pour l'instant.
: "${CALYPSO_ISA_E0_FAM:=1}"

# Modes d'adressage 7 (*ARn+0B) et 4 (*ARn-0B) = retenue INVERSEE (bit-reverse).
#   Etaient un +/-AR0 PLAT. Presents statiquement en PDROM 0xf1b3 (FFT).
#   ⚠️ MESURE 22/08 : sonde BITREV a 0 occurrence -> INERTE en profil natif.
#   La sonde (plafonnee a 24) affiche l'ecart avec l'ancien calcul plat.
: "${CALYPSO_ISA_BITREV:=1}"


# --- Modele gr-gsm : bequille d'horloge en mode NATIF ------------------
# ⚠️ Recale la FN du DSP sur le SCH decode par **gr-gsm**. En mode natif c'est
#   une BEQUILLE : le correlateur natif est juge avec l'horloge deja calee pour
#   lui. La ligne `[feed-daram-dsp] FN-ALIGN ... toa=23` affiche la valeur du
#   MODELE gr-gsm — a NE PAS lire comme un succes natif (piege vecu le 22/08).
#   Mettre 0 pour un verdict natif honnete. Defaut 1 = comportement historique.
: "${CALYPSO_GRGSM_FN_AUTOSYNC:=1}"


