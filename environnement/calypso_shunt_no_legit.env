# calypso_shunt_no_legit.env — mode "no-legit" (injections explicites)
# ---------------------------------------------------------------------------
# Restaure l'ancien mode qui campe + MT/MO SMS SANS le parapluie CALYPSO_SHUNT_LEGIT :
# on active a la main les injections que SHUNT_LEGIT impliquait (feed_si via INJECT_ACD,
# SB, AGCH/SDCCH/SACCH, DL inject, RACH UL depuis d_rach). real_fb garde FB/SB/rxlev host.
#
# Active quand CALYPSO_SHUNT_NO_LEGIT=1 (source par calypso.env). Idiome := => la CLI
# peut toujours surcharger chaque flag individuellement.
# ---------------------------------------------------------------------------
: "${CALYPSO_SHUNT_LEGIT:=0}"          # PAS le parapluie legit
: "${CALYPSO_SHUNT_REAL_FB:=1}"        # FB/SB/TOA/PM/AFC/SNR host (real_fb_read)
: "${CALYPSO_INJECT_SB:=1}"            # SB gr-gsm -> read-page natif
: "${CALYPSO_INJECT_ACD:=1}"           # SI3/CCCH -> a_cd (feed_si)
: "${CALYPSO_INJECT_AGCH:=1}"          # AGCH -> immediate assignment
: "${CALYPSO_INJECT_SDCCH:=1}"         # SDCCH DL (LU / SMS L3)
: "${CALYPSO_INJECT_SACCH:=1}"         # SACCH (mesures / L1 header)
: "${CALYPSO_SHUNT_DL_INJECT:=1}"      # injection DL structuree
: "${CALYPSO_UL_RACH_FROM_DRACH:=1}"   # RACH UL depuis d_rach (etablissement)
: "${CALYPSO_DECAN:=1}"                # modeles RF (AFC/PM/rxlev)
: "${CALYPSO_SHUNT_FEED_SI:=1}"     # feed SI3 gr-gsm -> a_cd (sysinfo) [gate SHUNT_LEGIT-only sinon]
: "${CALYPSO_TRF_RXLEV:=1}"          # livraison rxlev/PM (modele trf6151) [gate SHUNT_LEGIT-only sinon]
: "${CALYPSO_SHUNT_BURST_FN:=1}"        # timing burst (MT/MO SMS ok au run)
: "${CALYPSO_SHUNT_BURST_OFS:=-1}"       # offset burst -1 (aligne 2e etablissement)

# --- DSP completement shunte (host chain autoritaire, pas de c54x natif) ---
: "${CALYPSO_DSP_SHUNT:=1}"           # canned FB+SB, SKIP DSP
: "${CALYPSO_DSP_RUN_C54X:=0}"        # ne pas reveiller le c54x natif
: "${CALYPSO_SHUNT_AGCH_EXPIRE:=1}"   # expiry IMM-ASSIGN latche (fix no-cell-info post-dedie)
