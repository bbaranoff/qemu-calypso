# =============================================================================
#  config/debug.env — sondes et traces
# =============================================================================
#  Toutes SANS effet sur le comportement émulé : elles observent, elles ne
#  modifient rien. Toutes désactivées par défaut. Activez librement.
#
#  RÈGLE DE SONDE, payée cher : une sonde se conçoit par sa CONDITION DE
#  DÉCLENCHEMENT, pas par son adresse. Et « pas de log » n'est jamais « pas
#  d'événement » tant que la sonde n'est pas vérifiée vivante ET sa fenêtre
#  vérifiée couvrante.
# -----------------------------------------------------------------------------

# --- Cartes agrégées (comptent tout le run, impriment un tableau) -------------
# Qui ÉCRIT dans une plage mémoire : par PC, nombre d'écritures, valeurs
# distinctes à cellule figée, min/max. Signale sa propre saturation.
# : "${CALYPSO_WMAP:=1}" ; : "${CALYPSO_WMAP_LO:=0x2a00}" ; : "${CALYPSO_WMAP_HI:=0x2a1f}"

# Symétrique : quelles adresses LIT une plage de PC.
# : "${CALYPSO_RMAP:=1}" ; : "${CALYPSO_RMAP_PCLO:=0x9f00}" ; : "${CALYPSO_RMAP_PCHI:=0x9fff}"

# --- Traces ciblées ----------------------------------------------------------
# Corrèle lectures et écritures du démodulateur sur une fenêtre, avec A/B/T et AR.
# : "${CALYPSO_DEMODIO:=1}"

# Lectures de l'étage démod. Compteur à zéro = le démod n'est jamais atteint.
# : "${CALYPSO_WATCH_9F00_RD:=1}"

# Dump interne NON-RACY du tampon lu par le détecteur, exploitable par
# `tools/corr_iq.py --src ddump`. Sans lui, corr_iq relit un fichier périmé.
# : "${CALYPSO_DARAM_DUMP:=1}"

# Dump des opcodes et trace de flux depuis un PC. Ne se déclenche que sur un PC
# RÉELLEMENT EXÉCUTÉ : une adresse au milieu d'une instruction ne tirera jamais.
# : "${CALYPSO_TRACEFROM:=0x9fab}" ; : "${CALYPSO_TRACEFROM_N:=32}"

# Le dispatcher appelle-t-il vraiment le slot data[0x43d8] ? Se déclenche sur
# 0xb01c (dont on sait qu'il s'exécute) et journalise les N PC RÉELLEMENT
# exécutés ensuite — donc la destination mesurée, sans supposer que 0xb01e est
# le CALA. Replié : une ligne par trajectoire NOUVELLE, 40 max.
#   « ENTRE DANS LE SLOT » -> le handler est appelé, enchaîner TRACEFROM dessus
#   « slot JAMAIS atteint » -> ce n'est pas cette cellule qui est appelée
#   aucune ligne (mais la ligne « DISPCALL armé » est là) -> 0xb01c non atteint
# : "${CALYPSO_DISPCALL:=1}" ; : "${CALYPSO_DISPCALL_N:=10}"

# Où atterrit l'écriture ARM de d_dsp_page ? Le firmware l'exécute forcément
# (dsp.c:471, juste avant le SEUL « w_page ^= 1 » du firmware, et l'ARM écrit
# bien task_md en page 0 PUIS page 1), mais rien n'arrive jamais à l'offset
# 0x01A8 — ni au moniteur mailbox, ni à WR-OP. Deux sondes, plafonnées :
#   (a) offset 0x01A8 exactement, TOUTES valeurs (0 compris, ce que WR-OP rate)
#   (b) balayage : valeur 0x0002/0x0003 (= B_GSM_TASK|w_page) N'IMPORTE OÙ dans
#       la fenêtre API — la plage 0x01A8-0x0210 de WR-OP était arbitraire.
#       Replié par offset (32 max) + bilan tous les 2000 coups (10 max), pour
#       que l'ABSENCE soit mesurable et pas confondue avec un plafond atteint.
#   une ligne (a)         -> le store arrive ici, bug en AVAL (miroir data[])
#   zéro (a) + offset (b) -> le store part ailleurs, (b) nomme où
#   zéro des deux         -> il ne traverse pas ce hook : voir les memory_region
# : "${CALYPSO_DPAGE_HUNT:=1}"

# --- Namespace de jetons (≈105 clés, pas une variable) -----------------------
# Exemple : CALYPSO_DEBUG=BSP,CORRELATOR
# : "${CALYPSO_DEBUG:=BSP}"

# --- Moniteur mailbox ARM <-> DSP (calypso_mailbox.c) -------------------------
#  ACTIF PAR DÉFAUT, et c'est voulu. Il écrit dans SON fichier — $LOG_DIR/mailbox.log
#  — donc il ne peut pas noyer qemu.log ni tronquer les autres sondes. Les accès
#  répétés à l'identique sont repliés en « x N », si bien qu'une boucle de poll
#  qui relit la même cellule des millions de fois tient en une ligne.
#
#  Il existe parce que les sondes ponctuelles nous ont coûté une journée : chacune
#  câblée sur UNE adresse ou UNE valeur, donc aveugle à la question suivante — et
#  une sonde absente rend zéro, ce qui ressemble à une réponse.
: "${CALYPSO_MAILBOX:=0}"

#   =w écritures seules · =r lectures seules · =0 éteint
#   _CELLS ajoute des cellules hors mailbox (remplace WATCH_WR_ADDR)
#   _ONLY=1 ne garde que celles-là · _BRUT=1 désactive le repliement
#   _MAX plafond en lignes (défaut 5 000 000 ; 0 = illimité)
# : "${CALYPSO_MAILBOX_CELLS:=0x098b,0x098d,0x43d8}"
# : "${CALYPSO_MAILBOX_BRUT:=1}"

#   [2026-08-04] BITT-WATCH : chaine bitt -> TC -> roltc dans la fenetre de
#   l assembleur de bits 0x9ab8..0x9ad2, celui qui remet 0x2c3c..0x2c47 a zero
#   juste avant que le mvdd de 0x9723 ne publie a_cd[3..].
#   Lecture : nz=0 -> la SOURCE lue est vide, chercher en amont ; nz>0 et
#   tc1=0 -> bitt ou roltc faute. Sonde LECTURE SEULE, plafonnee (40 lignes
#   puis 1/5000), avec compteurs CUMULATIFS a cote.
#   defaut : code 0
# : "${CALYPSO_BITT_WATCH:=1}"

# ── TRACE ASM QEMU (-d/-D), en anneau ────────────────────────────────────────
#   CALYPSO_ASM = taille de l anneau en Mo. Vide ou 0 = eteint.
#   La trace part dans un fichier SEPARE (qemu-asm.log) : melangee a qemu.log
#   elle noierait les sondes du modele, qui ecrivent sur stderr.
#   Lecture : cat qemu-asm.prev qemu-asm.log   (ancien puis recent)
#
#   ⚠️ in_asm N EST PAS UNE TRACE D EXECUTION : QEMU ne vide un bloc de
#   traduction qu UNE FOIS, quand il le traduit. Une boucle executee un million
#   de fois n apparait qu a sa premiere traduction. Pour suivre l execution :
#   CALYPSO_ASM_FLAGS="in_asm,exec,nochain" — sans nochain les blocs chaines
#   s enchainent sans repasser par le journal, et la trace ment par omission.
#   Avec exec le debit se compte en dizaines de Mo/s : dimensionner l anneau.
: "${CALYPSO_ASM:=0}"
# : "${CALYPSO_ASM_FLAGS:=in_asm}"
# : "${CALYPSO_ASM_OUT:=}"
