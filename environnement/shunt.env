# -----------------------------------------------------------------------------

# --- Parametres legitimes (7) ----------------------------------------
#  Reglables. Le materiel reel a un equivalent.

#   defaut : code 20929.0
: "${CALYPSO_DECAN_PM_MAV_REF:=}"

#   defaut : code -60.0
: "${CALYPSO_DECAN_PM_RF_REF:=}"

#   defaut : code 4730 ; run.sh:2032 idem
: "${CALYPSO_SHUNT_GSMTAP_PORT:=}"

#   defaut : code 4731
: "${CALYPSO_SHUNT_SCH_PORT:=}"

#   defaut : code **1**
: "${CALYPSO_TRF_TSP_DEV:=}"

#   defaut : **ON**
: "${CALYPSO_TWL3025_AFC:=**ON**}"

#   defaut : code **6**
: "${CALYPSO_UL_ACU_OFS:=}"


