# environnement/local.env — écrit par « ./run.sh --configure ».
#
# Chargé EN PREMIER par load.env : avec l idiome « := », le premier qui pose
# une valeur gagne, donc ce fichier l emporte sur les défauts du dépôt. La
# ligne de commande le précède toujours (elle est déjà dans l environnement).
#
# Modifiable à la main, ou régénérable par « ./run.sh --configure ».

: "${CALYPSO_PROFILE:=hybrid}"
: "${CALYPSO_MODE:=shunt_legit}"
: "${CALYPSO_PIPELINE:=full-grgsm}"
: "${CALYPSO_LANG:=en}"
: "${CALYPSO_NO_ATTACH:=0}"

# --- Firmware ARM : on bascule sur l'arbre de build /opt/GSM/osmocom-bb -------
# [2026-07-30] Sans ces quatre lignes, paths.env prend la copie LIVREE AVEC LE
# DEPOT ($QEMU_TREE/firmware/compal_e88/, datee du 19/07) parce qu'elle existe
# et que son test « if [ -r ... ] » passe en premier. Resultat vecu : on
# recompile osmocom-bb et le run charge quand meme l'ancien ELF, sans un mot.
# Les QUATRE sont necessaires : poser FIRMWARE_DIR seul ne suffit pas, la
# premiere branche de paths.env construirait FIRMWARE_ELF sans le « board/ »
# de l'arborescence de build.
: "${FIRMWARE_DIR:=/opt/GSM/osmocom-bb/src/target/firmware}"
: "${FIRMWARE_ELF:=$FIRMWARE_DIR/board/compal_e88/layer1.highram.elf}"
: "${FIRMWARE_BIN:=$FIRMWARE_DIR/board/compal_e88/layer1.highram.bin}"
: "${FIRMWARE_MAP:=$FIRMWARE_DIR/board/compal_e88/layer1.highram.map}"
