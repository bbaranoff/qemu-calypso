# =============================================================================
#  environnement/bsp.env — BSP, DMA, DARAM, feed I-Q, horloge TDMA
# =============================================================================
#  Les quatre valeurs ci-dessous sont MESUREES, pas devinees. Ne pas les changer
#  sans refaire la mesure correspondante.
# -----------------------------------------------------------------------------

# Adresse ou le BSP ecrit le burst dans la DARAM du DSP.
# 0x4c00 = entree du demodulateur, CONFIRMEE : PC=0x9fb5 y lit en stride 5
# (filtre polyphase 6 taps), avec des valeurs reelles. 0 = mode decouverte.
: "${CALYPSO_BSP_DARAM_ADDR:=0x4c00}"

# Longueur de la fenetre d ecriture, en mots de 16 bits.
# 296 = 148 echantillons complexes = un burst apres decimation.
: "${CALYPSO_BSP_DARAM_LEN:=296}"

# Decimation du flux I-Q.
# /!\ 1 est une REGRESSION MESUREE : le feed arrive a 4 SPS et le correlateur
# voit dphi=+0.25x pi/2 au lieu de +1.00. Avec 4, corr_iq.py --src bursts
# affiche « FCCH @1SPS PROPRE ».
: "${CALYPSO_BSP_IQ_DECIM:=4}"

# Nombre d instructions DSP par tranche d execution (cadence).
: "${CALYPSO_DSP_BUDGET:=256000}"

# Adresse d ecoute du listener TRXDv0.
: "${CALYPSO_BSP_BIND_ADDR:=0.0.0.0}"

# -----------------------------------------------------------------------------
#  Inventaire complet du domaine, par categorie
# -----------------------------------------------------------------------------
# --- Parametres legitimes (17) ----------------------------------------
#  Reglables. Le materiel reel a un equivalent.

#   defaut : code 0.0.0.0 (bsp.c:907)
: "${CALYPSO_BSP_BIND_ADDR:=}"

#   defaut : unset (bsp.c:900)
: "${CALYPSO_BSP_BIND_LOOPBACK:=}"

#   defaut : code 0x2a00 (bsp.c:823) ; run.sh:1303 :-0x2a00 ; **live 0x4c00**
: "${CALYPSO_BSP_DARAM_ADDR:=}"

#   defaut : code 296 (bsp.c:824) ; live 296
: "${CALYPSO_BSP_DARAM_LEN:=}"

#   defaut : code 4 (bsp.c:591) ; **live =4**
: "${CALYPSO_BSP_IQ_DECIM:=}"

#   defaut : ON-sauf-0 (bsp.c:570-577) ; run.sh:1342 :-1 ; **live =1**
: "${CALYPSO_BSP_IQ_PASSTHROUGH:=}"

#   defaut : code BSP_TRXD_PORT=6702 (bsp.c:58, 913)
: "${CALYPSO_BSP_PORT:=}"

#   defaut : unset (bsp.c:868)
: "${CALYPSO_BSP_REPLAY_FILE:=}"

#   defaut : ON-sauf-0 (trx.c:1239) ; **live ON** (log [cpu-idle] governor ON ...
: "${CALYPSO_CPU_IDLE:=}"

#   defaut : code 0x00823000 (trx.c:1240)
: "${CALYPSO_IDLE_PC_LO:=}"

#   defaut : code 0x00826000 (trx.c:1241)
: "${CALYPSO_IDLE_PC_HI:=}"

#   defaut : code 2500 (dsp_shunt.c:1794, 1814)
: "${CALYPSO_IQ_CFILE_SPF:=}"

#   defaut : code 127.0.0.1 (bsp.c:410-419)
: "${CALYPSO_IQ_TEE_HOST:=}"

#   defaut : code 6703 (bsp.c:405-406) ; run.sh:1224 :=6703 ; **live =6703**
: "${CALYPSO_IQ_TEE_PORT:=}"

#   defaut : code D_RACH_DEFAULT_OFFSET=0x023A (bsp.c:1741) ; run.sh:1334 :- ;...
: "${CALYPSO_NDB_D_RACH_OFFSET:=}"

#   defaut : code WALL_TDMA_NS=4615384 (trx.c:1036, 1050-1051) ; **absente du ...
: "${CALYPSO_TDMA_NS:=}"

#   defaut : calypso.env:23 :=1, run.sh:1312 :-1 ; **live =1** (log REALTIME (...
: "${CALYPSO_TDMA_REALTIME:=}"


