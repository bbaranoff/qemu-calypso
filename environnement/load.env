# =============================================================================
#  environnement/load.env — chargeur de configuration
# =============================================================================
#
#  Point d'entrée UNIQUE de la configuration. Sourcé par start-clean.sh avec
#  `set -a`, donc tout ce qui est défini ici est exporté vers QEMU.
#
#      set -a ; . ./environnement/load.env ; set +a
#
#  ORDRE DE CHARGEMENT — il compte. Tous les fichiers utilisent l'idiome `:=`
#  (« si pas déjà défini »), donc **le premier qui pose une valeur gagne** :
#
#      1. la LIGNE DE COMMANDE            VAR=x ./run.sh      ← gagne toujours
#      2. modes.env                       le profil choisi
#      3. les fichiers par domaine        les défauts du domaine
#      4. calypso.env (hérité)            le reste, non encore migré
#
#  Vérifier ce qui s'applique réellement — la ligne de commande ment, pas le
#  manifeste :
#      grep "calypso-manifest" /root/qemu.log
# -----------------------------------------------------------------------------

_ENVDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# --- 0. Les choix de l opérateur (« ./run.sh --configure ») -------------------
# EN PREMIER, volontairement : avec « := », le premier qui pose une valeur gagne.
# Ce fichier l emporte donc sur tous les défauts du dépôt — mais pas sur la ligne
# de commande, déjà présente dans l environnement à cet instant.
[ -f "$_ENVDIR/local.env" ] && . "$_ENVDIR/local.env"

# --- 1. Où sont les dépendances (à régler en premier sur une machine neuve) ---
. "$_ENVDIR/paths.env"

# --- 2. Le profil : shunt_legit (défaut) | native | native_helped -------------
. "$_ENVDIR/modes.env"

# --- 3. Les domaines ---------------------------------------------------------
for _f in bsp dsp fbsb shunt armdsp opcodes; do
    [ -f "$_ENVDIR/$_f.env" ] && . "$_ENVDIR/$_f.env"
done

# --- 4. Sondes, sas, béquilles (tout désactivé par défaut) --------------------
. "$_ENVDIR/debug.env"
. "$_ENVDIR/fixes.env"
. "$_ENVDIR/crutches.env"

# --- 5. Héritage -------------------------------------------------------------
# L'ancien calypso.env monolithique, conservé le temps de la migration. Comme il
# n'utilise que `:=`, il ne peut rien écraser de ce qui précède : il ne fournit
# que les variables pas encore réparties dans les fichiers par domaine.
# À vider progressivement — quand il sera vide, supprimer cette ligne.
[ -f "$_ENVDIR/calypso.env" ] && . "$_ENVDIR/calypso.env"

unset _f _ENVDIR
