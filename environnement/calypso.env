# calypso.env -- pipeline Calypso : s'enregistre (LU Accept) + MT-SMS + chiffrement A5/1.
# Sourcé par start-clean.sh avec `set -a` -> TOUT est exporté vers run.sh/qemu.
# [REQUIS] = couplé au code/fix, NE PAS retirer ni changer.  [tune] = ajustable.

# ============================================================================
# CAPTURE / ENREGISTREMENT
# ============================================================================
# [2026-07-27] Mode no-legit EN PREMIER (avant les defauts) : ses := gagnent
# sur les defauts de ce fichier, la CLI gagne sur tout. CALYPSO_SHUNT_NO_LEGIT=1.
# Résolution des chemins RELATIVE À CE FICHIER, jamais au répertoire courant :
# ces sous-fichiers ont été regroupés dans environnement/, et la garde
# « [ -f ./x.env ] » échouait alors en silence — le mode demandé n'était pas
# chargé et rien ne le signalait.
: "${_ENVDIR:=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)}"

: "${CALYPSO_SHUNT_NO_LEGIT:=0}"

# CALYPSO_DCCH_FROM_IMMASSIGN — apprendre la sous-voie SDCCH depuis NOTRE IMM
# ASSIGN, au lieu d attendre le chan_nr que le firmware annonce apres coup.
#   LE BLOCAGE VISE : la fenetre de presentation a_cd (fn%51) depend du sous-canal.
#   Il n est connu que par set_dcch(), appelee sur DATA_CONF/DATA_IND -- donc APRES
#   l etablissement. Pendant le SABM/UA le shunt retombe sur base 22 (SS0), alors
#   que l IMM ASSIGN assigne chan_nr 0x28 = SS1. Le UA tombe a cote, le reseau
#   repond DM (mesure : 27 DM pour 18 UA), le LU echoue sur RR_REL_IND a 6 s.
#   ⚠️ DEFAUT 0, ET C EST DELIBERE : le filtre « ce RA est-il le notre ? » s appuie
#   sur g_last_recorded_ra, qui NE SUIT PAS le RACH courant (mesure : 5 IMM ASSIGN
#   sur 5 acceptes avec ra=0x07 quand le mobile emettait 0x0c/0x04/0x03). A 1, on
#   risque donc de poser la fenetre depuis l assignation d un AUTRE abonne -- deux
#   mobiles tournent sur ce banc. A n activer que pour experimenter, de preference
#   avec le mobile faketrx arrete.
: "${CALYPSO_DCCH_FROM_IMMASSIGN:=0}"

# CALYPSO_ACD_PROBE — le firmware LIT-il a_cd sur canal dedie ?
#   Compte les transitions de B_BLUD sur a_cd : 0->1 = presentation par le shunt,
#   1->0 = lecture par le firmware. Ne consomme rien, aucun effet sur le flux.
#   REPOND A : le LU echoue alors que tout l amont est prouve sain (RACH, IMM
#   ASSIGN, fenetre DL, base UL, UA present et sorti du ring, MSC qui alloue un
#   TMSI), et les DATA_IND remontes ne portent que 0x80/0x90 -- jamais un canal
#   dedie. Le segment presentation -> lecture -> DATA_IND est le seul non
#   instrumente ; cette sonde le coupe en deux.
#   ⚠️ Echantillonne en tete de tick, apres le retour anticipe « !pending » :
#   aveugle aux cycles sub-tick, sous-compte (~9 % constate sur a_dd_0). Elle
#   repond a « lit-il, oui ou non », pas a « combien ».
#   ⚠️ POSEE A 1 POUR LE DIAGNOSTIC EN COURS (09/08 au soir). Une valeur en ligne
#   de commande devant ./run.sh N ATTEINT PAS qemu : le manifeste est sourcé par
#   start-clean.sh avec `set -a` et c est LUI qui exporte. Remettre a 0 une fois la
#   question tranchee -- la sonde journalise toutes les 2000 ticks.
: "${CALYPSO_ACD_PROBE:=1}"
if [ "${CALYPSO_SHUNT_NO_LEGIT:-0}" = "1" ] && [ -f "$_ENVDIR/calypso_shunt_no_legit.env" ]; then . "$_ENVDIR/calypso_shunt_no_legit.env"; fi
: "${CALYPSO_SHUNT_LEGIT:=0}"
if [ "${CALYPSO_SHUNT_LEGIT:-0}" = "1" ] && [ -f "$_ENVDIR/calypso_shunt_legit.env" ]; then . "$_ENVDIR/calypso_shunt_legit.env"; fi

# [2026-07-27] Modes NATIFS (vars propres dans calypso_native*.env ; socle = ce fichier)
: "${CALYPSO_NATIVE:=0}"
if [ "${CALYPSO_NATIVE:-0}" = "1" ] && [ -f "$_ENVDIR/calypso_native.env" ]; then . "$_ENVDIR/calypso_native.env"; fi
: "${CALYPSO_NATIVE_HELPED:=0}"
if [ "${CALYPSO_NATIVE_HELPED:-0}" = "1" ] && [ -f "$_ENVDIR/calypso_native_helped.env" ]; then . "$_ENVDIR/calypso_native_helped.env"; fi

: "${CALYPSO_CANNED:=}"                     # vide = vrais SI décodés par grgsm (pas de SI bakés)
: "${CALYPSO_IRDA_CAPTURE:=0}"              # canal debug IrDA (off ; firmware IrDA perdu au reclone)
: "${CALYPSO_TDMA_REALTIME:=1}"
# [2026-07-30] Defaut remis a `off`. Ce n'est pas un revirement de gout : jusqu'a
# aujourd'hui le drapeau n'avait AUCUN consommateur (08-accel.sh le calculait,
# 40-qemu.sh ne le lisait pas), donc `auto` etait un defaut sans effet. En le
# branchant, `auto` deviendrait un `-icount auto` impose a tous les profils — et
# dans ce projet une cadence differente change le comportement de la L1, pas
# seulement la vitesse (piege CALYPSO_DSP_YIELD=0 : task=24 plus jamais dispatchee).
# Le legacy disait `off` (run.sh.legacy L1363, « DEFAUT OFF 2026-06-03 »), on le suit.
# Pour l'activer, c'est explicite en CLI : CALYPSO_ICOUNT=auto ./run.sh --restart
: "${CALYPSO_ICOUNT:=off}"
# --- IQ côté DSP (BSP RX, post-AFC, bursts livrés au corrélateur) ---
# Format par burst : header 12o [magic 'IQ16' | fn LE 4o | tn 1o | n_int16 LE 2o | pad 1o]
#                    puis n × int16 LE (I/Q interleaved).
# Relecture : python3 fcch_ref.py /dev/shm/bursts.cfile --fmt int16 --burst N
# NB : ne s'écrit que si le chemin BSP RX/corrélateur est driver (limité en DSP_SHUNT=1).
# [2026-07-30] Passé à l'idiome `:=` : c'était la seule affectation DURE de ce
# fichier, donc la seule variable qu'on ne pouvait pas surcharger en CLI (ni
# vider pour couper le dump). Source `--src bursts` de tools/corr_iq.py.
: "${BSP_DUMP_RX_FILE:=/dev/shm/bursts.cfile}"
# CALYPSO_IQDUMP=1              # alt : 24 premiers bursts en fichiers séparés /tmp/iq_rx_NNN.bin + iq_dlv_NNN.bin

# --- IQ côté shunt (entrée DSP vue par le shunt, fc32) + record ring relai BTS ---
: "${CALYPSO_SHUNT_IQ_CFILE:=/dev/shm/dsp_iq.fifo}" # fc32, FIFO live (FFT) — mkfifo avant QEMU (start-direct.sh)
# [2026-08-16] COUPE PAR DEFAUT. Ce dump n a jamais contenu d I/Q : sous
# CALYPSO_BRIDGE=pont, le BSP CASTE en int16 les 148 SOFT-BITS TRXD relayes par
# le pont, puis le shunt les divise par 32768. Chaque « echantillon complexe »
# est donc une PAIRE DE BITS. Verifie par le debit : 514 730 o/s mesures, soit
# ~1735 bursts/s, contre 1733,6 attendus pour 8 TS — c est un compte de BURSTS,
# pas d echantillons.
# Et il n a AUCUN plafond : 1,85 Go/h sur un /dev/shm de 8 Go QUI PORTE LES
# JOURNAUX. Il etait deja a 858 Mo au moment de la mesure.
# Remettre le chemin ici pour le rallumer ponctuellement (debug du shunt).
: "${CALYPSO_SHUNT_IQ_RECORD:=}"                      # fc32 ; vide=off — cf. ci-dessus
: "${CALYPSO_UL_IQ_RECORD:=/dev/shm/dsp_ul_iq.cfile}" # fc32, record I/Q UL synthetise (qemu_wrap, 4 SPS) ; vide=off
: "${CALYPSO_RECORD_FILE:=/dev/shm/record.cfile}" # ring 128Mo (~15.5s) du relai DL osmo-trx

# --- 3 FIFOs grgsm : clair (jamais tué) + chiffré (spawné dans la fenêtre RAND)
#     + TCH (spawné à l'ASSIGNMENT COMMAND, sur le timeslot assigné) ---
# La 2e FIFO alimente en continu le 2e grgsm (-e -k) -> décode le DL chiffré SANS
# jamais retirer le lecteur de la FIFO clair (ce qui figeait l'ipc-device au cipher).
# [2026-08-08] La 3e alimente le décodeur du canal dédié (-m TCHF -t <TN>) : voix,
# FACCH et SACCH du TCH. Elle DOIT exister dès le départ et être drainée en
# permanence — même raison que pour la FIFO chiffrée : un tube sans lecteur fige
# l'écrivain (ipc-device), et le brancher/débrancher au fil des appels rouvrirait
# exactement le trou que le design « on ne tue jamais le clair » a fermé.
: "${CALYPSO_RELAY_FIFOS:=/tmp/iq_fft.fifo:/tmp/iq_grgsm.fifo:/tmp/iq_grgsm_ciph.fifo:/tmp/iq_grgsm_tch.fifo:/tmp/iq_grgsm_tch_ciph.fifo:/tmp/iq_grgsm_sdcch.fifo:/tmp/iq_record.fifo:/tmp/iq_asciifft.fifo:/tmp/iq_full.fifo}"
# [2026-08-14] 9 TUBES. Le 5e (iq_grgsm_tch_ciph.fifo) alimente le décodeur TCH
# DL CHIFFRÉ (design B, -e -k) en parallèle du clair jamais tué — même couple
# clair/chiffré que le SDCCH. `RELAY_NFIFO_MAX` a été relevé de 8 à 12 dans
# qemu_wrap.c (recompilé) : sans ce bump un 9e tube serait ignoré EN SILENCE.

# --- CAPTURE COMPLETE (a cote du ring, jamais a sa place) --------------------
# Le ring record.cfile rembobine tous les 128 Mo (~15,5 s) : bon pour rejouer le
# passe immediat, inutilisable pour capturer un appel entier. Celle-ci ne
# rembobine JAMAIS et se declenche a chaud, sans relancer la chaine :
#     touch /tmp/iq_full.trigger   -> demarre    rm ... -> arrete et ferme
# ⚠️ PAS SUR TMPFS : 1083333 ech/s x 8 o = 8,7 Mo/s = 31 Go/h ; /dev/shm et /tmp
# sont de la RAM. Le defaut vise l'overlay (disque, 255 Go libres). `df -h` !
# ⚠️ Au plafond la capture S'ARRETE et le DIT — pas de rembobinage silencieux.
: "${CALYPSO_RECORD_FULL:=0}"                       # 0 = inactif (defaut)
: "${CALYPSO_RECORD_FULL_FIFO:=/tmp/iq_full.fifo}"
: "${CALYPSO_RECORD_FULL_FILE:=/opt/GSM/captures/full.cfile}"
: "${CALYPSO_RECORD_FULL_TRIGGER:=/tmp/iq_full.trigger}"
: "${CALYPSO_RECORD_FULL_MAX:=$((8 * 1024 * 1024 * 1024))}"   # 8 Go ~ 15 min
: "${CALYPSO_TCH_FIFO:=/tmp/iq_grgsm_tch.fifo}"
: "${CALYPSO_TCH_CIPH_FIFO:=/tmp/iq_grgsm_tch_ciph.fifo}"   # TCH DL chiffré (design B, -e -k)
# 4e decodeur : SDCCH/8 sur son propre timeslot (la BSC declare TS1 SDCCH8 et
# y assigne les 2/3 des canaux dedies ; un decodeur cale sur TS0 ne les voit
# pas du tout). Alimente en continu, jamais tue entre les appels.
: "${CALYPSO_SDCCH8_FIFO:=/tmp/iq_grgsm_sdcch.fifo}"

# ============================================================================
# TCH (voix) — chaîne dédiée du mode shunt_legit
# ============================================================================
# DL  : grgsm TCHF sur le timeslot assigné -> voix 33 o (/dev/shm/calypso_tch_dl),
#       FACCH (GSMTAP 0x08) et SACCH du dédié (0x88) -> 4730 -> a_dd_0 / a_fd / a_cd.
# UL  : le shunt capte a_fu / a_cu / a_du_1 -> 3 sidebands -> qemu_wrap encode et
#       injecte sur le slot montant du TCH.
# CFG : si_bridge décode l'ASSIGNMENT COMMAND -> /dev/shm/calypso_tch_cfg (TN/TSC/ARFCN).
: "${CALYPSO_INJECT_TCH:=}"                 # vide = suit CALYPSO_SHUNT_LEGIT
: "${CALYPSO_TCH_DL_TTL:=26}"               # âge max (ticks) d'une FACCH/SACCH DL re-présentée
: "${CALYPSO_UL_TCH:=1}"                    # injection montante du TCH (qemu_wrap)
: "${CALYPSO_TCH_SACCH_FN26:=}"             # vide = 12 si TN pair, 25 si TN impair (GSM 05.02)
: "${CALYPSO_TCH_DL_PROBE:=1}"              # SONDE (diagnostic pur, aucun effet sur le trafic) :
#                                           # confronte les 33 o FR de chaque TRAFFIC_IND aux 8
#                                           # dernières trames réellement écrites dans a_dd_0.
#                                           # Répond à : le firmware relaie-t-il ce qu'on lui donne ?
#                                           # Compteurs cumulatifs dans qemu.log (TCH-DL-PROBE).
#                                           # Remettre à 0 une fois la question tranchée.
: "${GAPK_ALSA_PROBE:=1}"                   # SONDE côté mobile (libosmo-gapk patché, cf.
#                                           # osmo_egprs/patches/gapk-pq-alsa-output-probe.patch).
#                                           # Le PCM remis à snd_pcm_writei est-il DÉJÀ nul
#                                           # (défaut en amont, chaîne gapk) ou non nul (défaut en
#                                           # aval, ALSA/PulseAudio) ? Compteurs cumulatifs dans
#                                           # mobile.log (GAPK-ALSA-PROBE). Inerte si != 1.
#                                           # ⚠️ Ce n'est PAS une vanne CALYPSO_* : c'est
#                                           # libosmo-gapk qui la lit, pas QEMU.

# ============================================================================
# CHIFFREMENT A5/1
# ============================================================================
# Kc capté par le filtre osmocon (L1CTL_CRYPTO_REQ) -> /dev/shm/calypso_kc :
#   [0..3]seq LE | [4]algo | [5]key_len=8 | [6..13]Kc | [14]CKSN. Clear sur DM_EST/DM_REL.
# UL  : qemu_wrap chiffre les bursts SDCCH montants (osmo_a5).
# DL  : si_bridge relance grgsm avec -e <algo> -k <Kc> dès qu'un Kc apparaît.
# BSC : osmo-bsc.cfg -> encryption a5 1.
: "${CALYPSO_CIPH_A5:=1}"                   # vide = algo auto depuis /dev/shm/calypso_kc ; 1 = force A5/1
: "${CALYPSO_CIPH_FN_ADJ:=0}"               # [tune] ajustement FN du keystream UL (0 = aligné, vérifié au run)

# ============================================================================
# osmo-trx (Transceiver.cpp)
# ============================================================================
: "${CALYPSO_START_FN:=}"                   # [REQUIS] horloge osmo-trx déterministe -> osmo_trx_fn == internal_fn
: "${CALYPSO_NB_MAXDLY:=40}"                # [REQUIS >0] fenêtre TOA burst normal (sinon SDCCH/SABM jamais détecté)

# ============================================================================
# UPLINK RACH / FN
# ============================================================================
: "${CALYPSO_UL_DEBUG:=}"
: "${CALYPSO_UL_SLOT_OFFSET:=}"             # [tune] TOA intra-slot du RACH (LU RACH-DET toa~4.6 = bon)
: "${CALYPSO_UL_RA:=}"                      # vide = RA auto
: "${CALYPSO_UL_FN_GATE:=}"                 # [REQUIS] RACH injecté seulement sur slot éligible
: "${CALYPSO_UL_FN_OFFSET:=}"               # [REQUIS] bloc SDCCH (couplé à eff_ofs=15 : 36+15=51≡0 -> gate ~internal_fn).
                               #   NB : le gate RACH ignore désormais cet offset (corrigé : gate sur internal_fn).
: "${CALYPSO_UL_RACH_STICKY:=}"             # [tune MT-SMS] nb de slots RACH-éligibles où la paging-response (encodée 1×)
                               #   est ré-injectée depuis g_rach_iq. Monter (16) si la 2e RACH-DET manque.

# ============================================================================
# IMM ASSIGN req-ref (FN-fix)
# ============================================================================
: "${CALYPSO_REQREF_ADJ:=}"                 # [REQUIS] req-ref = FN exact du RACH_CONF (ADJ!=0 -> mismatch). (rewrite à retirer via unif L1)

# ============================================================================
# SDCCH UL (SABM)
# ============================================================================
# CALYPSO_UL_SDCCH_OFS non défini -> eff_ofs=15 (offset déterministe ; Q pinné via ts_initial snap 102*5000).
: "${CALYPSO_UL_SABM_HOLD_TTL:=2}"          # [REQUIS] hold court : SABM décodée puis IDLE -> laisse passer le L3 (30 = flood)

# --- Anti-amplification SABM/I-frame UL (ajout 2026-08-15, diag MO) --------
# SYMPTOME : MT ok, MO KO. osmo-bts : MDL-ERROR-IND 12 (FRM_UNIMPL) +
# "N(S) sequence error ... LAPD_STATE_MF_EST" = trames UL DUPLIQUEES : le hold
# du sideband republie la meme trame et rearme son TTL a chaque capture -> la
# BTS recoit des repetitions, casse le lien -> Assignment Failure / SMS bloque.
# CORRECTIF (lecteur qemu_wrap.c) : pas de rearmement du hold si trame identique
# octet-pour-octet a celle tenue. Compteur cumulatif "SABM-DEDUP".
# BEQUILLE reversible : CALYPSO_UL_SABM_DEDUP=0 ./run.sh --reset revient a avant.
: "${CALYPSO_UL_SABM_DEDUP:=1}"

# ============================================================================
# NOTES
# ============================================================================
# Run-variance résiduel (MT-SMS "marche une fois") : le mobile doit être CAMPÉ quand le paging
# arrive. L'horloge L1 du mobile (seed SCH grgsm) est encore l'horloge NON unifiée -> camping pas
# 100% stable run-à-run. Le fix propre = unifier la L1 sur internal_fn (== osmo-trx) -> stabilise le
# camping ET retire le req-ref rewrite. C'est la prochaine étape.

# ============================================================================
# [DIAG c54x revive - 2026-07-20] Reveil du vrai c54x_run + catcher crash-PC.
#   `:=` -> ne remplit QUE si absente : une valeur passee en CLI/env gagne
#   TOUJOURS (jamais ecrasee par ce fichier). Pour desactiver : commenter
#   ce bloc, ou exporter la var =0 en CLI.
#   - CALYPSO_DSP=c54x        : active shunt_route_c54x (assist NDB overlay)
#   - CALYPSO_DSP_RUN_C54X=1  : REVEILLE le vrai c54x_run (le chemin qui crashe)
#   - CALYPSO_C54X_CRASHPC=1  : arme le catcher SIGSEGV/ABRT/FPE/BUS
#                               -> imprime '[c54x] *** CRASH ... last_pc=0x.... ***'
# ============================================================================
: "${CALYPSO_DSP:=c54x}"
: "${CALYPSO_DSP_RUN_C54X:=1}"
: "${CALYPSO_C54X_CRASHPC:=1}"

# [2026-07-22] Test wire correlateur : mode full = DSP_SHUNT=0 (gate BSP-RX ouvert).
# Verifier ensuite : tools/corr_iq.py --src daram
: "${CALYPSO_MODE:=full-grgsm}"

# [2026-07-23] LEGIT (ex-hack.env) : pont ARM->DSP fidele. Sur l ecriture ARM
# B_GSM_TASK (d_dsp_page), pose data[0x0fff] bit1 = le task-ready word que le
# dispatcher ROM DSP (0xb41c) poll deja. ZERO poke PC/IMR/INTM/SP/vecteur : le
# DSP dispatche via sa PROPRE ROM. Faithful data wire, pas une bequille.
: "${CALYPSO_ARM2DSP:=0}"

# ============================================================================
# [2026-07-24] GO-LIVE NATIF — Fix A / BGEN (VALIDÉ CE RUN).
# L'ARM pose d_background_enable/state (0x098a/0x098c) — donnée que le phase-SM
# DSP (0xdddb) poll déjà — one-shot, sur commande de tâche (d[0x0fff]&2). Le DSP
# prend alors la branche GO, pose d[0x3f70] bit1 LUI-MÊME -> sort de la wait-loop
# [0xa4ca..0xa4e2] (spin "10 en 10" INTM -> 0) -> franchit 0xa53c (d_ctrl_system
# 0x0810, clear DSP à 0xa549) -> atteint FB0_SEARCH (real DSP path).
# ZÉRO poke PC/IMR/INTM/SP : faithful data wire. REMPLACE la béquille DSP-side
# CALYPSO_FORCE_098 (-> calypso_hack.env). Cell/val/pollpc tunables.
# ============================================================================
: "${CALYPSO_ARM2DSP_BGEN:=1}"
# : "${CALYPSO_ARM2DSP_BGEN_A:=0x098a}"      # d_background_enable
# : "${CALYPSO_ARM2DSP_BGEN_C:=0x098c}"      # d_background_state
# : "${CALYPSO_ARM2DSP_BGEN_VAL:=0x0001}"    # valeur posée (inférée : branche BC A==0)
#
# [2026-08-03] LES DEUX CELLULES ONT DES POLARITES OPPOSEES. Decodage PROM0 :
#     0xddeb  LD *(0x098a),A ; BC 0xde8a, AEQ   -> 098a == 0 declenche le reset
#     0xde86  LD *(0x098c),A ; BC 0xddf5, ANEQ  -> 098c != 0 fait REBOUCLER
# Il faut donc 098a != 0 ET 098c == 0. Ecrire 1 dans les deux verrouille la
# seconde condition. MESURE le 03/08 en native_twl : PHASE-SM-EA #3 100 000 tours
# a pc=0xde86 avec d[0x098c]=0x0001 — la phase-SM n'atteint jamais 0xde9c, le DSP
# ne sort jamais du go-live, donc JAMAIS de FBSB natif.
# Ce remede est documente dans calypso_arm2dsp.c depuis le 29/07 mais ne pouvait
# PAS fonctionner : le miroir api_ram de la cellule C ecrivait _VAL au lieu de
# _VAL_C (corrige le 03/08), et c'est api_ram que le DSP lit au-dessus de 0x0800.
: "${CALYPSO_ARM2DSP_BGEN_VAL_C:=0}"       # polarite INVERSE de _VAL — cf. ci-dessus
# : "${CALYPSO_ARM2DSP_BGEN_POLLPC:=0xdddb}" # PC du poll phase-SM
# : "${CALYPSO_ARM2DSP_BGEN_ONESHOT:=1}"     # 1 = UNE seule transition go-live

# [2026-07-24] Probe FN feed corrélateur (RO, diag) : burst_fn (livraison BSP,
# posée à bsp_enqueue) vs dispatcher_fn (calypso_trx_get_fn) CÔTE À CÔTE dans
# bsp_take_for_fn. delta CONSTANT = offset (fix 1 ligne) ; delta qui DÉRIVE =
# horloge. Prochaine frontière : fb0_att=0 = bursts jugés périmés/futurs.
: "${CALYPSO_BSP_FN_PROBE:=1}"

# [2026-07-22] Option 2 : feed DARAM 0x2a00 direct (calypso_bsp_rx_burst) sans
# match FN. Commenter pour revenir a bsp_enqueue->deliver_buffered.
: "${CALYPSO_BSP_DIRECT_FEED:=1}"
# [2026-07-27] SKIP rx_burst DARAM (cede 0x2a00 a feed_iq). DEFAUT 0 =
# rx_burst nourrit toujours 0x2a00 -> SHADOW-DADST/kernel vivant. =1
# seulement si feed_iq->0x2a00 prouve (FB-IQ-MARKER visible).
: "${CALYPSO_FB_IQ_OWNS:=0}"

# [2026-07-22] Detection FCCH REELLE host-side sur la RX (coherence+dphi) ->
# injecte d_fb_det/AFC/SNR/TOA/PM REELS dans le NDB (bypass go-live DSP). Gate.
: "${CALYPSO_SHUNT_REAL_FB:=0}"  # [fix] respecte le CLI (etait =0 dur)

# [2026-07-22] B : lance grgsm (decode SI du stream continu structure) EN FULL ->
# feed_si -> a_cd -> le mobile a le BCCH/SI (comme full-grgsm qui campe).
: "${CALYPSO_FORCE_DEMOD_BRIDGE:=1}"

# [2026-07-22] B : relais CONTINU du DL structure -> /tmp/iq_grgsm.fifo -> grgsm_decode.
: "${CALYPSO_IPC_RELAY:=1}"

# [REQUIS pour le LU] Chemin MONTANT du pont ipc-device. Sans cette variable,
# qemu_wrap.c fait g_ul_on=0 : ul_drain() n'est jamais appelé et le bloc
# d'injection RACH ne peut pas s'exécuter. QEMU encode alors correctement
# l'access-burst (trace « RACH-RA encode »), mais il ne quitte jamais le pont —
# aucun CHAN RQD côté BTS, aucune IMMEDIATE ASSIGNMENT, T3126 expire et le
# LOCATION UPDATING ACCEPT n'arrive jamais. Le legacy la posait en run.sh:1113 ;
# elle avait été perdue lors du découpage des variables dans environnement/.
: "${CALYPSO_IPC_UL:=1}"
: "${CALYPSO_RELAY_ALSO_BSP:=1}"

# [2026-07-23] burst-ID : PAS un bug d'offset. Sonde WP-BURST prouve que l'ARM
# ne commande QUE burst 0 (22501 writes, 0 non-zero) -> d_burst_d bloque a 0,
# aucun OFS/FN/PERCMD ne peut matcher la sequence 0,1,2,3 attendue. Racine =
# amont (ARM ne deroule pas le schedule per-burst CCCH). Vars burst laissees
# au defaut code (echo PERCMD). Ne pas tuner l'offset : c'est un symptome.


# [2026-07-22] Fake FB du shunt (shunt_dispatch_fb, d_fb_det=1 bidon) TOUJOURS gate,
# meme HACK=0 : on ne veut jamais de fausse detection FB. Toute FB det = reelle.

# ============================================================================
# [2026-07-22] Bequilles/diag go-live DSP -> calypso_hack.env.
# CALYPSO_HACK=1 (defaut) = bequilles ON (push Frontiere A) ; =0 = run propre.
# ============================================================================
: "${CALYPSO_HACK:=0}"
if [ "${CALYPSO_HACK:-0}" = "1" ] && [ -f "$_ENVDIR/calypso_hack.env" ]; then . "$_ENVDIR/calypso_hack.env"; fi


# ============================================================================
# [2026-07-23] FIX ISA MVDM/MVMD (0x72/0x73) : PAS une bequille -- decode
# conforme tic54x-opc. Debloque la SM go-live 0xaad5 (sinon A fige a 0) ->
# le DSP lit db_w (d_task_md) + atteint le dispatcher trame. ON par defaut
# (aussi cable en dur dans c54x.c) ; OFF possible via CALYPSO_FIX_MVDM_OFF=1.
# ============================================================================
: "${CALYPSO_FIX_MVDM:=1}"

# [2026-07-25] LE DSP ENTRE-T-IL EN CORREL ? trace PC dans [0x8d00..0x9000]
# (corrélateur FB-det PROM0). Si 0 ligne CORRELATOR-TRACE -> le DSP n atteint
# JAMAIS 0x8d00 (bloque avant, en amont du dispatch FB). Si >0 -> il entre.
: "${CALYPSO_CORRELATOR_TRACE:=1}"
# trace le PC DSP brut (INTM/vec) pour voir le chemin vers le dispatch FB :
: "${CALYPSO_INTM_TRANS:=1}"

# [2026-07-25] TEST discriminant : d[0x3f92]=0 fait-il boucler le rejet a575 ?
# force bits 14+15 avant les lectures 0xa539/0xa566. Si a575 sarrete + 0x8d00 hit
# -> d[3f92] etait le gate. Sinon -> cest 0x0810. Mettre =0xC000 pour activer.
: "0xC000"

# [2026-07-25] TEST: d[0x3f92]=0 gate le rejet a575 ? force bits14+15 @0xa539/0xa566.
# a575 stop + 0x8d00 hit => 3f92 etait le gate. sinon => 0x0810. =0xC000 on, vide off.
: "${CALYPSO_FORCE_3F92:=}"

# [2026-07-25] poke data[0x0810] (operande reel du BITF) en meme temps que 3f92.
: "${CALYPSO_FORCE_0810:=}"

# [2026-07-25] intuition user: le go-live attend TINT0 (vec20) apres chaque RSBX INTM.
# ---------------------------------------------------------------------------
# [2026-07-27] PROFIL "WIRE" — DESACTIVE PAR DEFAUT (opt-in CALYPSO_WIRE=1)
# ---------------------------------------------------------------------------
# Ces bequilles (TINT0_MASTER, BSP_DIRECT_BRINT0, + tout calypso_wire.env :
# FORCE_INTM_ONESHOT, KEEP_IMR, BSP_DISPATCH_FB, ARM2DSP_CTRLSYS...) ont ete
# ecrites quand le mode natif ne pouvait PAS tourner (SIGSEGV au boot + DSP
# jamais sorti de son bootloader — cf RAPPORT_DFBDET.md §1).
# Une fois ces defauts corriges, la mesure du 2026-07-27 (§8) montre que le
# graphe d appels de la tache FB est IDENTIQUE avec et sans elles : elles sont
# INERTES sur ce chemin. Deux avaient meme des effets de bord :
#   - BSP_DIRECT_BRINT0=1 : le BSP levait vec21 -> preemptait la routine FB
#     (l IT qu on a chassee pendant deux manches etait de notre fait)
#   - FORCE_INTM_ONESHOT=1 : run.sh le signalait deja « NON-nominal »
# Reactivation : CALYPSO_WIRE=1 ./start-clean.sh  (ou toute variable a la main,
# l idiome := laisse la valeur CLI gagner).
if [ "${CALYPSO_WIRE:-0}" = "1" ]; then
    # TINT0 = vrai timer DSP, jamais leve nativement -> on le rend pending.
    : "${CALYPSO_TINT0_MASTER:=1}"
    : "${CALYPSO_TINT0_PERIOD:=1500}"
    # direct-feed leve BRINT0 (vec21) = reveil correlateur
    : "${CALYPSO_BSP_DIRECT_BRINT0:=1}"
    # profil de wiring (un wire par poke, ancre code+osmo+log)
    if [ -f "$_ENVDIR/calypso_wire.env" ]; then . "$_ENVDIR/calypso_wire.env"; fi
    echo "[calypso.env] PROFIL WIRE ACTIF (CALYPSO_WIRE=1) : bequilles 2026-07-25 chargees" >&2
fi
