# =============================================================================
#  config/armdsp.env — Pont ARM<->DSP, parapluies shunt
# =============================================================================
#  47 variables. Reference complete (defaut, effet mesure, mode, idiome,
#  dependances) : ../hw/arm/calypso/doc/VARIABLES_ENVIRONNEMENT.md
#
#  RAPPEL : `=0` ne coupe pas tout. Quatre idiomes coexistent ; pour celles
#  qui testent la PRESENCE de la variable, seul `unset` les desactive.
# -----------------------------------------------------------------------------

# --- Parametres legitimes (16) ----------------------------------------
#  Reglables. Le materiel reel a un equivalent.

#   defaut : code 0x098a
: "${CALYPSO_ARM2DSP_BGEN_A:=}"

#   defaut : code 0x098c
: "${CALYPSO_ARM2DSP_BGEN_C:=}"

#   defaut : code 0x0001
: "${CALYPSO_ARM2DSP_BGEN_VAL:=}"

#   defaut : code 0xdddb
: "${CALYPSO_ARM2DSP_BGEN_POLLPC:=}"

#   defaut : **code 1 si absente** (arm2dsp.c:125)
: "${CALYPSO_ARM2DSP_BGEN_ONESHOT:=}"

#   defaut : code 0x0810
: "${CALYPSO_ARM2DSP_CTRLSYS_CELL:=}"

#   defaut : code 0x8000
: "${CALYPSO_ARM2DSP_CTRLSYS_VAL:=}"

#   defaut : code 0xa537
: "${CALYPSO_ARM2DSP_CTRLSYS_POLLPC:=}"

#   defaut : code 0x0fff
: "${CALYPSO_ARM2DSP_TASKWORD:=}"

#   defaut : code 0x0002
: "${CALYPSO_ARM2DSP_TASKBIT:=}"

#   defaut : code : nm(l1s) sinon 0x836508 ; run.sh:1805 exporte la valeur nm ...
: "${CALYPSO_L1S_FN_ADDR:=}"

#   defaut : code : nm(last_rach) sinon 0x836500 ; run.sh:1806
: "${CALYPSO_LAST_RACH_FN_ADDR:=}"

#   defaut : run.sh:1147 :=1 puis **run.sh:1151 =1 VERROUILLÉ** en full-grgsm ...
: "${CALYPSO_SHUNT_NO_CANNED:=}"

#   defaut : hack.env:42-43 :=1 + export DUR (donc effectif seulement si CALYP...
: "${CALYPSO_SHUNT_NO_FAKE_FB:=}"

#   defaut : hack.env:45-46 :=0 + export DUR
: "${CALYPSO_SHUNT_NO_FAKE_PM:=}"

#   defaut : unset
: "${CALYPSO_SHUNT_NO_GRGSM:=unset}"


