# @BEQUILLE — NATIVE_HELPED  (CALYPSO_NATIVE_HELPED=1, defaut OFF)
#   masque  : ce profil n'est PAS le mode natif. Il REPOSE automatiquement
#             CALYPSO_FB_CORR_ENTRY=0x9500, CALYPSO_FB_ENERGY=1,
#             CALYPSO_FB_IQ_DARAM=1, CALYPSO_FB_IQ_BASE=0x9210.
#             Retirer FB_CORR_ENTRY de la ligne de commande ne le supprime donc
#             pas : il revient au defaut. Un run qui garde NATIVE_HELPED ne teste
#             jamais le chemin natif, il compare deux bequilles.
#   retirer : quand le chemin natif atteint le correlateur seul.
#   ⚠️ Lire le MANIFESTE ([calypso-manifest] dans le log), jamais la ligne de commande.

# calypso_native_helped.env — mode NATIF AIDÉ (feed_iq alimente la source du démod)
# ---------------------------------------------------------------------------
# Variante "helped" du natif : au lieu de l'intercept lecture (FB-STREAM), c'est
# feed_iq qui écrit DIRECT la source du démod en DARAM (CALYPSO_FB_IQ_DARAM +
# CALYPSO_FB_IQ_BASE=0x9210 -> atterrit sur data[0x9213]/[0x9215] que l'étage
# démod 0x9f00 lit). + WATCH_2A00 pour observer la sortie workzone. Le corrélateur
# DSP natif reste le producteur de d_fb_det. Go-live armé (shadow, SANS CTRLSYS).
# Active : CALYPSO_NATIVE_HELPED=1. Idiome := => CLI surcharge.
# ---------------------------------------------------------------------------
: "${CALYPSO_FB_ENERGY:=1}"              # reroute CALA -> corrélateur énergie
: "${CALYPSO_FB_CORR_ENTRY:=0x9500}"     # entrée corrélateur
: "${CALYPSO_FB_IQ_DARAM:=1}"            # feed_iq écrit la source démod en DARAM
: "${CALYPSO_FB_IQ_BASE:=0x9210}"        # base = 0x9210 -> 0x9213(I)/0x9215(Q)
: "${CALYPSO_WATCH_2A00:=1}"             # trace la sortie workzone 0x2a00
: "${CALYPSO_DECAN:=1}"                  # modèles RF (IQ réaliste)
# --- DSP natif tourne + go-live armé (pour que le corrélateur soit dispatché) ---
: "${CALYPSO_DSP_RUN_C54X:=1}"           # réveille le c54x natif
: "${CALYPSO_DSP_SHUNT:=0}"              # NE PAS shunter le DSP
: "${CALYPSO_ARM2DSP_BGEN:=1}"           # go-live (ARM pose 098a/098c)
: "${CALYPSO_ARM2DSP_CTRLSYS:=0}"        # PAS de CTRLSYS
: "${CALYPSO_KEEP_IMR:=1}"               # maintient l'IMR armé
: "${CALYPSO_INIT_435B_OFF:=0}"          # seed shadow d[0x435b]
: "${CALYPSO_FRAME_IT_NATIVE:=1}"        # frame-IT native
# --- pas d'injection résultat host ---
: "${CALYPSO_SHUNT_LEGIT:=0}"
: "${CALYPSO_SHUNT_NO_LEGIT:=0}"
