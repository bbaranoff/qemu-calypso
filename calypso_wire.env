# calypso_wire.env — état VALIDÉ du run (2026-07-25) : go-live natif + corrélateur atteint.
# Sourcé par calypso.env. Idiome `:=` : une valeur CLI gagne toujours.
# Ces défauts = les variables ON dans le run qui débloquent la chaîne.
# Règle du bug appris : pour DÉSACTIVER un gate teste par getenv()!=NULL, il faut
# `unset VAR` (pas `:=` vide, qui exporte une chaine vide = non-NULL = ON).

# ============================================================================
# GO-LIVE NATIF (IMR bit5 tenu, INTM natif, arm unique) — VALIDÉ
# ============================================================================
: "${CALYPSO_ARM2DSP_BGEN:=1}"        # ARM pose 0x098a/0x098c -> sort wait-loop
: "${CALYPSO_ARM2DSP_CTRLSYS:=1}"     # RANK1 : ARM pose d_ctrl_system 0x0810 bit15 -> gate go-live 0xa53c fall-through bootstrap/FB (câblé cote ARM, pas poke DSP)
: "${CALYPSO_KEEP_IMR:=1}"            # re-arme IMR=0x52fd (bit5/BRINT0) qd il tombe (fix 0xb37e+0xa509)
: "${CALYPSO_INIT_435B_OFF:=0}"      # 0 = shadow IMR d[0x435b]=0x52fd peuplé
: "${CALYPSO_SEED5AC8_VAL:=0xa4c7}"  # entrée go-live via ORM+RSBX natif (si SEED5AC8 on)
: "${CALYPSO_FRAME_IT_NATIVE:=1}"    # frame-IT vec28/bit12

# ============================================================================
# CADENCE / INTERRUPTIONS (TINT0 + BRINT0 servis)
# ============================================================================
: "${CALYPSO_TINT0_MASTER:=1}"       # TINT0 (vec20) pending -> INTM natif se libère
: "${CALYPSO_TINT0_PERIOD:=1500}"
: "${CALYPSO_FORCE_INTM_ONESHOT:=1}" # clear INTM 1x qd BRINT0 pending -> bootstrap 0xa51b RSBX

# ============================================================================
# CORRÉLATEUR : réveil + dispatch (atteint 0x8d00) — RESTE : read (buffer/pointeurs)
# ============================================================================
: "${CALYPSO_BSP_DIRECT_BRINT0:=1}"  # BSP lève BRINT0 vec21 à la mission FB/SB (task_md)
: "${CALYPSO_BSP_DISPATCH_FB:=1}"    # install 0x8d00 dans slot dispatch par burst (RANK3)

# ============================================================================
# DIAG / PROBES (RO)
# ============================================================================
: "${CALYPSO_INTM_TRANS:=1}"
: "${CALYPSO_CORRELATOR_TRACE:=1}"
: "${CALYPSO_BSP_FN_PROBE:=1}"

# ============================================================================
# OFF explicitement (nuisibles / diag qui stormait) — UNSET, pas ":=vide"
# ============================================================================
unset CALYPSO_ISR_TO_8341            # redirect PC 0x013b->0x8341 : storm (saute contexte overlay)
unset CALYPSO_CORR_SETUP             # inject AR @0x8d00 : inefficace (AR réécrits avant 0x8e8b)
unset CALYPSO_FORCE_3F92             # poke gate : insuffisant (audit REMOVE-POKE)
unset CALYPSO_FORCE_0810             # poke gate : met B_TASK_ABORT -> abort (nuisible)

# [2026-07-25] peuple le buffer I/Q correlateur DARAM 0x2a00 sous shunt (cause #1 read diag)
: "${CALYPSO_BSP_DARAM_FORCE:=1}"

# ===== RANK1b FIX NATIF (workflow overlay) =====
# 0x013b prologue retourne a 0xa4e4 (init natif) au lieu du self-loop 0x72d5
: "${CALYPSO_FIX_3FCD:=1}"
# compagnon : force DP=0x124 a 0x7234 -> LUT 0x8341 resout OK (pas garbage)
: "${CALYPSO_FORCE_DISPATCH:=1}"

unset CALYPSO_BSP_DISPATCH_ONESHOT   # pulse reverte : regresse 0x3f92 (task word plus remaintenu) + double-IMR persiste

# ============================================================================
# RANK2 : chaîne RX native (TPU RX-window -> BDLENA -> BSP -> DARAM 0x2a00 + d[3f92])
# Hybride réversible : lève les gates shunt (trx.c DMA task, bsp.c delivery) pour
# alimenter le vrai corrélateur DSP. wire d[3f92] via le TPU (consumer BDLENA).
# ============================================================================
: "${CALYPSO_TPU_RX_WIRE:=1}"
