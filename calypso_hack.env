# calypso_hack.env — béquilles go-live / corrélateur DSP.
# Sourcé par calypso.env UNIQUEMENT si CALYPSO_HACK=1 (défaut 0 = run natif propre).
# Idiome `:=` : une valeur passée en CLI gagne toujours.
#
# ÉTAT 2026-07-24 (ce run) : le go-live est désormais NATIF via CALYPSO_ARM2DSP_BGEN
# (calypso.env) — l'ARM pose 0x098a/0x098c, le DSP sort seul de la wait-loop et
# atteint FB0_SEARCH. Ces béquilles ne sont donc PLUS le chemin principal ; elles
# restent pour pousser Frontière A quand le natif ne suffit pas. Règle : les
# retirer UNE À UNE et vérifier au log (une seule variable non déterministe).
# Croiser toujours log <-> c54x.c <-> code attendu osmo (ndb.h / layer1).

# --- IMR / INTM (band-aids : le natif doit armer via 0xa4c7 ORM / 0xa582 STL) ---
: "${CALYPSO_KEEP_IMR:=1}"          # re-arme IMR=0x3000 tant que PC dans [0xa4ca..0xa4e2].
                                    #   ENCORE actif ce run. Test natif = le passer à 0 avec BGEN=1.
: "${CALYPSO_INIT_435B_OFF:=0}"     # 0 = init du shadow IMR d[0x435b] (=0x52ed observé). 1 = OFF.
# : "${CALYPSO_C54X_FORCE_IMR:=}"   # force IMR (diagnostic dur) — laisser vide si KEEP_IMR suffit.

# --- Wait-loop / phase-SM go-live (SUPERSEDÉS par BGEN natif : garder VIDES) ---
: "${CALYPSO_FORCE_098:=}"          # poke DSP-side de 0x098a/0x098c. REMPLACÉ par CALYPSO_ARM2DSP_BGEN.
: "${CALYPSO_FORCE_GOLIVE:=}"       # force d[0x3f70] bit1 au test 0xa4d4. Superflu si BGEN pose le handshake.
: "${CALYPSO_SEED5AC8:=}"           # seed mem[0x5ac8] (band-aid stack go-live). _VAL=0x71f4|0xa4c7.
: "${CALYPSO_POKE_A4C7_ONCE:=}"     # redirige 1er 0xa4ca -> 0xa4c7 (falsification, pas un fix).

# --- FB / corrélateur (fausse détection host-side : garder OFF, on veut du réel) ---
: "${CALYPSO_SHUNT_REAL_FB:=0}"     # 1 = FB det réelle host-side injectée dans le NDB (bypass DSP). 0 = DSP détecte.
: "${CALYPSO_FORCE_FBSB:=0}"        # 0 = pas de forçage FBSB.
: "${CALYPSO_SHUNT_DL_INJECT:=0}"   # 0 = pas d'injection DL directe.
: "${CALYPSO_FORCE_AGCH:=0}"        # 0 = pas de forçage AGCH.

# [2026-07-26] DIAG : force un offset AFC constant (Hz) cote TWL3025/Iota, court-circuite
# la chaine DAC (get_afc_hz renvoie cette constante). 0 = OFF = boucle AFC REELLE active.
# Etait force a 16000 dans run.sh (band-aid "stoppe la chasse AFC") -> defaisait la
# convergence -> vire. Ne mettre !=0 QUE pour diag carrier-stable sans AFC.
: "${CALYPSO_TWL3025_AFC_HZ:=0}"
export CALYPSO_TWL3025_AFC_HZ

# [2026-07-26] FAKE FB du shunt : force d_fb_det=1 (transporte la detection gr-gsm
# au resultat DSP) car le correlateur NATIF ne deroule pas (RANK2/3). 1 = fake
# RETIRE par defaut -> le vrai etat natif est expose (d_fb_det=0 tant que le
# go-live bloque -> le mobile ne sync plus = normal, on isole RANK2/3). Mettre 0
# pour restaurer le camp shunt_legit (fake ON).
: "${CALYPSO_SHUNT_NO_FAKE_FB:=1}"
export CALYPSO_SHUNT_NO_FAKE_FB
# Fake PM (a_pm force). 0 = laisse le dispatch PM (rxlev). 1 = retire.
: "${CALYPSO_SHUNT_NO_FAKE_PM:=0}"
export CALYPSO_SHUNT_NO_FAKE_PM
